# Keep this key on the API server. Never put it in the GitHub Pages files.
RUNWARE_API_KEY=your_runware_api_key
RUNWARE_BASE_URL=https://api.runware.ai/v1
# Optional JSON array. Replace this list to expose other Runware AIR image models.
RUNWARE_MODELS='[{"id":"openai:gpt-image@2.5-flare","label":"GPT Image 2.5 Flare","description":"速度优先，适合日常生成"},{"id":"openai:gpt-image@2.5-sunburst","label":"GPT Image 2.5 Sunburst","description":"质量优先，适合复杂画面"},{"id":"openai:gpt-image@2","label":"GPT Image 2","description":"通用 GPT 图片模型"},{"id":"recraft:v4.1@0","label":"Recraft V4.1","description":"设计、图形与文字排版"},{"id":"bfl:flux@3-image","label":"FLUX 3 Image","description":"高质量通用视觉生成"}]'
RUNWARE_USER_AGENT=style-atlas/0.3
HOST=0.0.0.0
ALLOWED_ORIGINS=https://styleatlas.art,https://www.styleatlas.art,https://liuyahui59.github.io,http://localhost:4173,http://127.0.0.1:4173
IMAGE_GENERATION_LIMIT=5
PORT=4173

# Billing uses a signed guest session until a full member system is added.
# Use a long random value in production; never commit the real value.
BILLING_REQUIRED=true
SESSION_SECRET=replace_with_a_long_random_secret
BILLING_DATABASE_PATH=./data/style-atlas.sqlite
BILLING_SUCCESS_URL=https://styleatlas.art/?payment=success
BILLING_CANCEL_URL=https://styleatlas.art/?payment=cancelled

# International cards and wallets via Stripe Checkout.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Mainland China Alipay / WeChat via Ping++.
PINGXX_SECRET_KEY=sk_test_replace_me
PINGXX_APP_ID=app_replace_me
PINGXX_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----'
PINGXX_BASE_URL=https://api.pingxx.com
